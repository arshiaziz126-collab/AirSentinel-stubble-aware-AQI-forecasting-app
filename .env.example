# Copy to backend/.env
# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ (needed only to download real fire data)
FIRMS_MAP_KEY=
# Comma-separated list of sites allowed to call the API, or * for any
ALLOWED_ORIGINS=*
# Optional: the day the app opens on, YYYY-MM-DD. Empty = 2 November of the latest year.
AS_OF=
